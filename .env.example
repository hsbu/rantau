# Copy to ignored .env and set values locally. Never share actual API keys.
APP_ENV=development
DATABASE_URL=postgresql://rantau_demo:local_demo_only@127.0.0.1:5432/rantau_demo
OPENROUTER_API_KEY=
# Set an OpenRouter provider/model ID with JSON-schema structured-output support.
OPENROUTER_MODEL=
# Read-only Chat also requires verified auth and explicit agent storage migration:
# uv run python -m backend.agent.migrations (no automatic migration/seed at startup).
# Set this server-only variable in frontend/.env.local for local browser-to-backend relay.
# Docker Compose supplies the backend service origin separately.
AGENT_API_ORIGIN=http://127.0.0.1:8000
# Optional server-only origin for the payments/demo pages; defaults to AGENT_API_ORIGIN.
# FINANCE_API_ORIGIN=http://127.0.0.1:8000

# Opt-in backend authentication; configure only in ignored local .env.
AUTH_ENABLED=false
AUTH_TENANT_ID=demo_001
AUTH_TRUSTED_ORIGIN=http://127.0.0.1:3000
# Distinct local passwords, 12-128 characters; remove after explicit bootstrap.
AUTH_DEMO_STUDENT_PASSWORD=
AUTH_DEMO_SPONSOR_PASSWORD=
# Bounded owner approval lifetime; always capped by quote expiry (1-3600 seconds).
APPROVAL_TTL_SECONDS=600
